    "@zfaf/db": "workspace:*",
    "@zfaf/infra": "workspace:*",
    "@zfaf/shared": "workspace:*",
    "bullmq": "^6.1.1",
    "libheif-js": "^1.19.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
