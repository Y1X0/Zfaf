# Build scripts run only for packages we have explicitly reviewed.
# Everything else is installed without executing lifecycle scripts, which
# closes a well-known supply-chain vector (docs/12-security-threat-model.md §7).
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=@prisma/client
onlyBuiltDependencies[]=prisma

strict-peer-dependencies=false
auto-install-peers=true
