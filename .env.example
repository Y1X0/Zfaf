# ──────────────────────────────────────────────────────────────────────
# Zfaf — example environment. Copy to .env and fill in.
# NEVER commit a real .env. All values below are placeholders.
# ──────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Public base URL of the app (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://zfaf:zfaf_local_dev@localhost:5432/zfaf?schema=public

# ── Redis (rate limiting, queues, counters) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── Sessions ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-characters-of-random-data

# ── Two-factor authentication (docs/09 §2.8) ──────────────────────────
# Encrypts TOTP secrets at rest. A TOTP secret cannot be hashed — verifying a
# code recomputes an HMAC from the original bytes — so this key is what keeps a
# database dump from yielding working second factors.
#
# Must NOT be the same value as SESSION_SECRET: rotating the session secret is
# routine, and rotating this one stops every enrolled authenticator at once.
# Rotating it is a planned operation with a re-enrollment plan, never a reflex.
# Generate with: openssl rand -base64 48
TOTP_ENCRYPTION_KEY=replace-me-with-a-different-48-bytes-of-random-data

# ── Object storage (MinIO locally, Cloudflare R2 in production) ────────
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET_MEDIA=zfaf-media
STORAGE_ACCESS_KEY_ID=zfaf_local_dev
STORAGE_SECRET_ACCESS_KEY=zfaf_local_dev_secret
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/zfaf-media

# ── Media processing (ADR-0023) ───────────────────────────────────────
# `queue`  — the upload is handed to BullMQ and `apps/worker` encodes it,
#            isolated from the request budget. The original design, and the
#            default: leave this alone unless you know why you are changing it.
# `inline` — the encode happens in the request that completed the upload. No
#            worker process, and no retry either — which is why production
#            refuses this combination without CRON_SECRET below.
MEDIA_DISPATCH=queue

# Bearer token for POST /api/internal/jobs/{job}, called by a scheduler.
# Unset means the endpoint refuses everything, which is the safe default: it
# sweeps storage and expires invitations. At least 32 characters.
#   openssl rand -base64 48
CRON_SECRET=

# ── Email (Mailpit locally, Resend in production) ─────────────────────
# `noop` exists for tests and is refused in production: a driver that sends
# nothing leaves a customer waiting at an inbox for a link that was never sent,
# with nothing logged and nothing thrown.
# ⚠️ `smtp` has no adapter yet: the composition root falls back to the no-op
# transport and logs an error, so nothing reaches Mailpit. Production refuses
# both `smtp` and `noop` for exactly that reason.
MAIL_DRIVER=smtp
MAIL_SMTP_URL=smtp://localhost:1025
# Required when MAIL_DRIVER=resend. The sending domain needs SPF, DKIM and
# DMARC verified before first traffic, or the verification link lands in spam
# and the whole publish flow stalls (docs/14 §9).
# MAIL_RESEND_API_KEY=
# Where the Resend adapter posts. Unset in production, where it defaults to the
# provider's API; the end-to-end suite points it at a local sink so the real
# adapter is exercised instead of a transport that sends nothing.
# MAIL_RESEND_ENDPOINT=
MAIL_FROM_ADDRESS=no-reply@zfaf.test
MAIL_FROM_NAME=Zfaf

# ── Market ────────────────────────────────────────────────────────────
# ISO 3166-1 alpha-2. See ADR-0015 — nothing about a market may be
# hard-coded in application code.
DEFAULT_MARKET=SA

# ── Optional ──────────────────────────────────────────────────────────
# Cache purge for the moderation kill switch. Without these an invitation is
# still suspended immediately at the origin; cached copies live out their TTL,
# and the audit entry says so.
# CDN_ZONE_ID=
# CDN_API_TOKEN=
# SENTRY_DSN=
# Guards the component detail on /api/health/deep. Without it the probe still
# answers with an overall verdict, but never names which dependency is down —
# that answer is useful to somebody deciding when to attack.
# HEALTH_CHECK_TOKEN=
# TURNSTILE_SECRET_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
